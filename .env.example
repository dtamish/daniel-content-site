PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
PUBLIC_FIREBASE_API_KEY=YOUR_WEB_API_KEY
PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
PUBLIC_FIREBASE_APP_ID=YOUR_WEB_APP_ID
