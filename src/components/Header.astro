---
import settings from '../data/site.json';
import { withBase } from '../lib/urls';

const links = [
  { href: withBase(''), label: 'ראשי', exact: true },
  { href: withBase('posts/'), label: 'כל התכנים' },
  { href: withBase('about/'), label: 'אודות' },
];
const pathname = Astro.url.pathname;
const isActive = (href: string, exact = false) =>
  exact ? pathname === href : pathname.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('')} aria-label={`${settings.title} — עמוד הבית`}>
      <span class="brand-name">{settings.title}</span>
      <span class="brand-label">{settings.siteLabel}</span>
    </a>
    <nav aria-label="ניווט ראשי">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href, link.exact) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
