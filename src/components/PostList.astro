---
import type { CollectionEntry } from 'astro:content';
import { formatHebrewDate, withBase } from '../lib/urls';

interface Props {
  posts: CollectionEntry<'posts'>[];
  headingLevel?: 2 | 3;
}

const { posts, headingLevel = 3 } = Astro.props;
const Heading = headingLevel === 2 ? 'h2' : 'h3';
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <article>
        <div class="post-meta">
          <time datetime={post.data.pubDate.toISOString()}>{formatHebrewDate(post.data.pubDate)}</time>
          {post.data.tags.length > 0 && <span>{post.data.tags.join(' · ')}</span>}
        </div>
        <Heading><a href={withBase(`posts/${post.id}/`)}>{post.data.title}</a></Heading>
        <p>{post.data.description}</p>
      </article>
    </li>
  ))}
</ul>
