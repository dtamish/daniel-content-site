---
import settings from '../data/site.json';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title={settings.aboutTitle} description={settings.aboutBody}>
  <div class="reading-shell">
    <header class="page-heading">
      <p class="eyebrow">הקשר</p>
      <h1>{settings.aboutTitle}</h1>
      <p>{settings.aboutBody}</p>
    </header>
    <section class="info-panel" aria-labelledby="principle-heading">
      <h2 id="principle-heading">העיקרון</h2>
      <p>התוכן שייך לבעל האתר ונשמר בקבצי Markdown ו־JSON רגילים. מערכת הניהול היא שכבת עריכה נוחה — לא המקום היחיד שבו המידע קיים.</p>
    </section>
  </div>
</BaseLayout>
