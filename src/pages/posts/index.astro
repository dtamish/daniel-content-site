---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="כל התכנים" description="כל הטקסטים והתהליכים שפורסמו במחברת של דניאל דהאן.">
  <div class="shell">
    <header class="page-heading">
      <p class="eyebrow">הארכיון</p>
      <h1>כל התכנים</h1>
      <p>הכול במקום אחד, מהחדש לישן. טיוטות אינן מופיעות כאן עד שהן מוכנות לפרסום.</p>
    </header>
    {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty-state">עדיין אין תכנים שפורסמו.</p>}
  </div>
</BaseLayout>
